---
// The hero scene: the long table. Server HTML, reduced-motion users, browsers without WebGL and
// slow devices get the settled table as a still. Everyone else gets it in three.js, which loads
// only after the page is idle, then fades in over the still and assembles plank by plank.
---
<div class="hero-art" data-hero aria-hidden="true">
  <picture>
    <source media="(max-width: 820px)" srcset="/brand/hero-still-mobile.svg" width="760" height="380" />
    <img class="hero-static" src="/brand/hero-still.svg" width="760" height="560" alt="" fetchpriority="high" />
  </picture>
</div>

<script>
  function canRun3D() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return false;
    try {
      const c = document.createElement('canvas');
      return !!(c.getContext('webgl2') || c.getContext('webgl'));
    } catch {
      return false;
    }
  }

  const host = document.querySelector<HTMLElement>('[data-hero]');
  if (host && canRun3D()) {
    const start = () =>
      import('./hero/scene')
        .then(({ mount }) => {
          let dispose: (() => void) | undefined;
          dispose = mount(
            host,
            () => host.classList.add('is-live'),
            () => {
              host.classList.remove('is-live');
              setTimeout(() => dispose?.(), 900);
            },
          );
        })
        .catch(() => {
          /* keep the still */
        });
    if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 2500 });
    else setTimeout(start, 1200);
  }
</script>

<style is:global>
  .hero-art { position: relative; width: 100%; aspect-ratio: 760 / 560; }
  .hero-art picture, .hero-static, .hero-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .hero-canvas { opacity: 0; transition: opacity 500ms var(--ease); }
  .hero-static { transition: opacity 700ms var(--ease); }
  .hero-art.is-live .hero-canvas { opacity: 1; }
  .hero-art.is-live .hero-static { opacity: 0; }
  @media (max-width: 820px) {
    .hero-art { aspect-ratio: 2 / 1; }
  }
</style>
