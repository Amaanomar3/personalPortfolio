---
import '../styles/global.css';
import { SITE, NAV } from '../site';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}
const { title, description = SITE.description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const is404 = /^\/404\/?$/.test(Astro.url.pathname);
const ogImage = new URL(SITE.ogImage, SITE.url).href;
const path = Astro.url.pathname;
const year = new Date().getFullYear();
const isCurrent = (href: string) => path === href || path.startsWith(href);
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  url: SITE.url,
  description: SITE.headline,
  homeLocation: { '@type': 'Place', name: 'Cape Town, South Africa' },
  worksFor: { '@type': 'Organization', name: 'QuickLaunch', url: SITE.links.quicklaunch },
  sameAs: [SITE.links.linkedin, SITE.links.x, SITE.links.github],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!is404 && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SITE.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@Amaan_0mar" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={SITE.ogImageAlt} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#F3E9DA" />
    <link rel="preload" href="/fonts/Fraunces-VF.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Figtree-VF.woff2" as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container bar">
        <a class="logo" href="/" aria-label="Amaan Omar, home">
          <img src="/brand/wordmark.svg" alt="" width="137" height="30" />
        </a>
        <button
          class="menu-toggle"
          type="button"
          aria-controls="site-nav"
          aria-expanded="false"
          aria-label="Open menu"
        >
          <span class="menu-icon" aria-hidden="true"></span>
        </button>
        <nav id="site-nav" class="site-nav" aria-label="Main">
          <ul>
            {NAV.map((item) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer on-dark">
      <div class="container foot">
        <div class="foot-id">
          <a class="foot-logo" href="/" aria-label="Amaan Omar, home">
            <img src="/brand/wordmark-light.svg" alt="" width="137" height="30" />
          </a>
          <p class="foot-headline">{SITE.headline}</p>
        </div>
        <ul>
          <li><a href={SITE.links.linkedin} rel="me noopener" target="_blank">LinkedIn</a></li>
          <li><a href={SITE.links.x} rel="me noopener" target="_blank">X</a></li>
          <li><a href={SITE.links.github} rel="me noopener" target="_blank">GitHub</a></li>
          <li><a href="/speaking-writing/">Speaking and writing</a></li>
        </ul>
        <p class="foot-meta">© Amaan Omar {year} · Cape Town</p>
      </div>
    </footer>

    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.getElementById('site-nav');
      if (toggle && nav) {
        const set = (open: boolean) => {
          toggle.setAttribute('aria-expanded', String(open));
          toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
          nav.classList.toggle('open', open);
        };
        toggle.addEventListener('click', () => set(toggle.getAttribute('aria-expanded') !== 'true'));
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && nav.classList.contains('open')) { set(false); toggle.focus(); }
        });
      }
    </script>
  </body>
</html>

<style>
  .skip { position: absolute; left: -999px; top: 0; padding: 0.5rem 1rem; background: var(--color-accent); color: var(--color-accent-ink); z-index: 20; }
  .skip:focus { left: 1rem; top: 1rem; }

  .site-header { position: sticky; top: 0; z-index: 10; background: color-mix(in srgb, var(--color-bg) 92%, transparent); backdrop-filter: blur(8px); border-bottom: var(--hairline) solid var(--color-line); }
  .bar { display: flex; align-items: center; justify-content: space-between; min-height: 76px; gap: var(--space-3); }
  /* clear space round the wordmark = the height of its capital A (about 0.5 of its height) */
  .logo { display: block; padding-block: 15px; margin-block: -15px; }
  .logo img { height: 30px; width: auto; }
  .site-nav ul { display: flex; align-items: center; gap: var(--space-3); list-style: none; margin: 0; padding: 0; }
  .site-nav a { color: var(--color-ink); text-decoration: none; font-weight: var(--weight-strong); font-size: var(--text-sm); }
  .site-nav a:hover { color: var(--color-accent); }
  .site-nav a[aria-current=page] { box-shadow: inset 0 -2px 0 var(--color-accent); }
  .site-nav li:last-child a { background: var(--color-accent); color: var(--color-accent-ink); padding: 0.7em 1.1em; border-radius: var(--radius-pill); box-shadow: none; }
  .site-nav li:last-child a:hover { background: var(--color-ink); color: var(--color-bg); }

  .menu-toggle { display: none; background: none; border: var(--hairline) solid var(--color-line); border-radius: var(--radius); width: 44px; height: 44px; cursor: pointer; position: relative; }
  .menu-icon, .menu-icon::before, .menu-icon::after { position: absolute; left: 11px; width: 20px; height: 2px; background: var(--color-ink); transition: transform var(--dur) var(--ease), opacity var(--dur); }
  .menu-icon { top: 20px; }
  .menu-icon::before, .menu-icon::after { content: ""; }
  .menu-icon::before { left: 0; top: -6px; }
  .menu-icon::after { left: 0; top: 6px; }
  .menu-toggle[aria-expanded=true] .menu-icon { background: transparent; }
  .menu-toggle[aria-expanded=true] .menu-icon::before { transform: translateY(6px) rotate(45deg); }
  .menu-toggle[aria-expanded=true] .menu-icon::after { transform: translateY(-6px) rotate(-45deg); }

  @media (max-width: 820px) {
    .bar { min-height: 64px; }
    .logo img { height: 27px; }
    .menu-toggle { display: block; }
    .site-nav { display: none; position: absolute; top: 64px; left: 0; right: 0; background: var(--color-bg); border-bottom: var(--hairline) solid var(--color-line); }
    .site-nav.open { display: block; }
    .site-nav ul { flex-direction: column; align-items: stretch; gap: 0; padding: var(--space-1) var(--gutter) var(--space-3); }
    .site-nav a { display: block; padding: 0.85rem 0; font-size: var(--text-lg); }
    .site-nav a[aria-current=page] { box-shadow: none; color: var(--color-accent); }
    .site-nav li:last-child { margin-top: var(--space-2); }
    .site-nav li:last-child a { display: inline-block; font-size: 1rem; padding: 0.9em 1.4em; }
  }

  .site-footer { margin-top: var(--space-5); padding-block: var(--space-5) var(--space-4); font-size: var(--text-sm); }
  .foot { display: grid; grid-template-columns: 1fr auto; gap: var(--space-3) var(--space-4); align-items: start; }
  .foot-logo { display: inline-block; }
  .foot-logo img { height: 30px; width: auto; }
  .foot-headline { margin: var(--space-2) 0 0; max-width: 30rem; font: var(--weight-display) var(--text-lg)/1.35 var(--font-display); font-variation-settings: var(--display-axes); color: var(--color-on-dark); }
  .foot ul { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-3); list-style: none; margin: 0; padding: 0; }
  .foot a { color: var(--color-on-dark); font-weight: var(--weight-strong); text-decoration: none; }
  .foot a:hover { color: var(--color-highlight); text-decoration: underline; }
  .foot-meta { grid-column: 1 / -1; margin: 0; padding-top: var(--space-3); border-top: var(--hairline) solid color-mix(in srgb, var(--color-on-dark) 18%, transparent); color: var(--color-on-dark-muted); }
  @media (max-width: 720px) { .foot { grid-template-columns: 1fr; } .foot-logo img { height: 27px; } }
</style>
