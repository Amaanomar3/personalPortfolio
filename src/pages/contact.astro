---
import Base from '../layouts/Base.astro';
import { SITE } from '../site';
---
<Base
  title="Contact | Amaan Omar"
  description="Get in touch with Amaan Omar about AI for your startup or venture, advisory work or speaking."
>
  <div class="container page-head contact">
    <div class="prose">
      <h1>Get in touch</h1>
      {/* [CONFIRM] "I read every one" only if Amaan reads the Netlify form inbox. */}
      <p>
        If you're building a startup or venture with AI, or you'd like me to advise your team or speak at your
        event, send me a message. I read every one.
      </p>
    </div>

    <form class="form" name="contact" method="POST" action="/success/" data-netlify="true" netlify-honeypot="company">
      <input type="hidden" name="form-name" value="contact" />
      <p class="visually-hidden">
        <label>Leave this empty: <input name="company" tabindex="-1" autocomplete="off" /></label>
      </p>
      <label>Name <input type="text" name="name" autocomplete="name" required /></label>
      <label>Email <input type="email" name="email" autocomplete="email" required /></label>
      <label>Message <textarea name="message" rows="6" required></textarea></label>
      <button class="btn btn-primary" type="submit">Send</button>
    </form>

    <div>
      <h2>Elsewhere</h2>
      <ul class="elsewhere">
        <li><a href={SITE.links.linkedin} rel="me noopener" target="_blank">LinkedIn</a></li>
        <li><a href={SITE.links.x} rel="me noopener" target="_blank">X (@Amaan_0mar)</a></li>
        <li><a href={SITE.links.github} rel="me noopener" target="_blank">GitHub</a></li>
        <li><a href={SITE.links.quicklaunch} rel="noopener" target="_blank">QuickLaunch</a></li>
      </ul>
    </div>
  </div>
</Base>

<style>
  .contact { display: grid; gap: var(--space-4); }
  .form { display: grid; gap: var(--space-2); max-width: 560px; }
  .form label { display: grid; gap: 0.35rem; font-weight: 600; }
  .form input, .form textarea {
    font: inherit; color: var(--color-ink); background: var(--color-surface);
    border: 1px solid var(--color-line); border-radius: 10px; padding: 0.75rem 0.9rem;
  }
  .form input:focus, .form textarea:focus { border-color: var(--color-accent); outline: none; }
  .form button { justify-self: start; cursor: pointer; font: inherit; font-weight: 600; }
  .elsewhere { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; }
</style>
